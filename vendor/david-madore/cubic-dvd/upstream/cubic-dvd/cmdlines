for mov in ... ; do mkdir -p /data4/cubic-dvd/FRAMES/$mov ; cd /data4/cubic-dvd/FRAMES/$mov ; dchroot -d -c 32 povray +I$HOME/cubic-dvd/${mov}.pov $HOME/cubic-dvd/animation.ini ; $HOME/cubic-dvd/makeanim ${mov} ; mv ${mov}.mpg /data4/cubic-dvd/MPEG ; mv ${mov}.short.mpg /data4/cubic-dvd/ANIM ; cd .. ; done

